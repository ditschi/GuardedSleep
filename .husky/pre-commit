#!/usr/bin/env sh
set -e
cd "$(dirname "$0")/.." || exit 1
# Dev Container as root: HOME is /root but post-create installs pre-commit under node.
export PATH="${HOME}/.local/bin:/home/node/.local/bin:${PATH}"
if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit not found. Install: pip install pre-commit   (or open Dev Container)"
  exit 1
fi
pre-commit run
