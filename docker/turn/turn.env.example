# Environment for compose.yaml. Copy to `.env` next to the compose file (git-ignored).

# --- Required ---

# Public IPv4 of the VPS (Oracle: instance details → Primary VNIC → Public IPv4 address).
TURN_PUBLIC_IP=203.0.113.10
# Private IPv4 the VPS sees on its interface (`ip -4 -br addr`), e.g. 10.0.0.x on Oracle.
TURN_PRIVATE_IP=10.0.0.10
# Any stable name, usually the DNS name of the server.
TURN_REALM=turn.example.org
# Generate with: openssl rand -hex 24 (hex only: the image entrypoint evaluates arguments).
TURN_PASSWORD=

# --- Optional ---

# TURN_USER=guardedsleep
# TURN_PORT=3478
# Relay range; must match the firewall rules. 41 ports carry about 20 parallel sessions.
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200
# TURN_USER_QUOTA=12
# TURN_TOTAL_QUOTA=100
# Bytes per second per session (125000 = 1 Mbit/s).
# TURN_MAX_BPS=125000
# COTURN_TAG=4.18.0
