# Environment for compose.traefik.yaml. Copy to `.env` next to the compose file.

# --- Required ---

# Public hostname Traefik routes to the signaling server (DNS must point at your Traefik host).
SIGNALING_DOMAIN=signal.example.com

# GitHub owner/org publishing the images (lowercase). Alternatively set SIGNALING_IMAGE.
GUARDEDSLEEP_OWNER=
# SIGNALING_IMAGE=ghcr.io/OWNER/guardedsleep-signaling:dev

# `latest` exists only after the first release; use `dev` until then (ADR-008).
SIGNALING_TAG=latest

# --- Match your Traefik setup ---

# External Docker network shared with the Traefik container.
TRAEFIK_NETWORK=proxy
# HTTPS entrypoint name in your Traefik static config.
TRAEFIK_ENTRYPOINT=websecure
# ACME certificate resolver name in your Traefik static config.
TRAEFIK_CERTRESOLVER=letsencrypt
# Router/service name prefix. Traefik names are global across stacks; change it when running
# several GuardedSleep instances behind one Traefik.
TRAEFIK_ROUTER_PREFIX=guardedsleep

# --- Optional ---

# Serve signaling under a path, e.g. /signaling (clients then use wss://<domain>/signaling).
# No prefix stripping is needed: the server accepts WebSocket upgrades on any path.
# SIGNALING_PATH_PREFIX=/

# Domain the web app is served from; used to derive the browser Origin allowlist.
# APP_DOMAIN=app.example.com

# Explicit browser Origin allowlist (comma-separated). Defaults to https://${APP_DOMAIN:-SIGNALING_DOMAIN}.
# Native clients without an Origin header are always accepted.
# SIGNALING_ALLOWED_ORIGINS=https://app.example.com

# SIGNALING_MAX_PARENTS=1
# SIGNALING_HELLO_TIMEOUT_MS=30000
# PULL_POLICY=always
