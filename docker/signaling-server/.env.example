# Copy to docker/signaling-server/.env and adjust (Compose loads .env next to the compose file).

# Host port → container PORT (default 8787)
SIGNALING_PORT=8787

# Port inside the container (must match the right side of ports mapping)
SIGNALING_INTERNAL_PORT=8787

# --- Signaling process (Docker or bare metal) ---
# Browser Origin allowlist (comma-separated), e.g. https://app.example
# Required when NODE_ENV=production (the container image sets production). Native clients and
# tools without an Origin header are still accepted if the allowlist is set.
SIGNALING_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
#
# Max parent units per room (one baby + N parents). Default 1 (MVP 1:1), max 256.
# SIGNALING_MAX_PARENTS=1
#
# Time until a valid "hello" must be received (ms). Default 30000.
# SIGNALING_HELLO_TIMEOUT_MS=30000
#
# WebSocket liveness ping interval (ms). Default 10000, min 2000. Sockets that miss one ping are dropped.
# SIGNALING_PING_INTERVAL_MS=10000
#
# Per-IP limits (per minute): hello attempts (default 20) and new rooms (default 10); 0 disables.
# SIGNALING_HELLO_RATE_PER_MIN=20
# SIGNALING_NEW_ROOM_RATE_PER_MIN=10
#
# Open sockets per client IP (default 16; 0 disables) and frames per socket and minute before and
# after joining (defaults 120 and 600; 0 disables). Behind a proxy these need SIGNALING_TRUST_PROXY=1.
# SIGNALING_MAX_CONNECTIONS_PER_IP=16
# SIGNALING_FRAME_RATE_UNJOINED_PER_MIN=120
# SIGNALING_FRAME_RATE_PER_MIN=600
#
# Behind a reverse proxy set 1 to take the client IP from the rightmost X-Forwarded-For hop (the one
# the proxy appended). With several chained proxies set the count; the n-th hop from the right is used.
# SIGNALING_TRUST_PROXY=0
# SIGNALING_TRUSTED_PROXY_HOPS=1

# --- Built-in STUN responder (UDP, Binding requests only; on by default) ---
# Responses are at most 44 bytes and 2.2x the request; each source address gets STUN_RATE_PER_MIN
# (default 60) answers per minute.
# Host UDP port published for STUN (the container listens on 3478). Point clients at stun:<host>:<port>.
# STUN_PORT=3478
# Set 1 to turn the responder off (publishing the port then has no effect).
# STUN_DISABLED=0

# --- compose.ghcr.yaml only (pre-built image from GHCR) ---
# See ADR-008 for tag semantics. Two ways to point at an image:
#
# (a) Owner + tag (recommended for typical self-hosters):
# GUARDEDSLEEP_OWNER=guardedsleep
# SIGNALING_TAG=latest   # latest | dev | vX.Y.Z
#
# (b) Full image reference (overrides (a) when set):
# SIGNALING_IMAGE=ghcr.io/YOUR_GITHUB_USER_OR_ORG/guardedsleep-signaling:vX.Y.Z
#
# `latest` does not exist until the first release is cut — use `dev` during the
# pre-release / PoC phase.
# PULL_POLICY=always
