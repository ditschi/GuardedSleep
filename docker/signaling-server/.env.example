# Copy to docker/signaling-server/.env and adjust (Compose loads .env next to the compose file).

# Host port → container PORT (default 8787)
SIGNALING_PORT=8787

# Port inside the container (must match the right side of ports mapping)
SIGNALING_INTERNAL_PORT=8787

# --- Signaling process (Docker or bare metal) ---
# Browser Origin allowlist (comma-separated), e.g. https://app.example
# Required when NODE_ENV=production (the container image sets production). Native clients and
# tools without an Origin header are still accepted if the allowlist is set.
SIGNALING_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
#
# Max parent units per room (one baby + N parents). Default 32, max 256.
# SIGNALING_MAX_PARENTS=32
#
# Time until a valid "hello" must be received (ms). Default 30000.
# SIGNALING_HELLO_TIMEOUT_MS=30000

# --- compose.ghcr.yaml only (pre-built image from GHCR) ---
# See ADR-008 for tag semantics. Two ways to point at an image:
#
# (a) Owner + tag (recommended for typical self-hosters):
# GUARDEDSLEEP_OWNER=guardedsleep
# SIGNALING_TAG=latest   # latest | dev | vX.Y.Z
#
# (b) Full image reference (overrides (a) when set):
# SIGNALING_IMAGE=ghcr.io/YOUR_GITHUB_USER_OR_ORG/guardedsleep-signaling:vX.Y.Z
#
# `latest` does not exist until the first release is cut — use `dev` during the
# pre-release / PoC phase.
# PULL_POLICY=always
