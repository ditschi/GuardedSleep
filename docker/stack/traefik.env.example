# Environment for docker/stack/compose.traefik.yaml. Copy to `.env` next to the compose file.

# --- Required ---

# Public hostname for the web app; signaling is served at wss://<APP_DOMAIN>/signaling.
APP_DOMAIN=baby.example.com

# GitHub owner/org publishing the images (lowercase). Alternatively set SIGNALING_IMAGE / WEB_IMAGE.
GUARDEDSLEEP_OWNER=

# `latest` exists only after the first release; use `dev` until then (ADR-008).
SIGNALING_TAG=latest
WEB_TAG=latest

# --- Match your Traefik setup ---

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Traefik router/service names are global; change when running several instances.
TRAEFIK_ROUTER_PREFIX=guardedsleep

# --- Optional ---

# Defaults to https://${APP_DOMAIN}. Native clients without an Origin header are always accepted.
# SIGNALING_ALLOWED_ORIGINS=https://baby.example.com
# SIGNALING_MAX_PARENTS=1
# SIGNALING_HELLO_TIMEOUT_MS=30000
# PULL_POLICY=always
