# Example environment for docker/stack compose files.
# Copy to `docker/stack/.env` and run from repo root:
#   docker compose -f docker/stack/compose.yaml --env-file docker/stack/.env up --build
#
# Or auto-detect host LAN IP (phone/tablet on same Wi-Fi):
#   pnpm run stack:lan:env    # writes docker/stack/.env
#   pnpm run stack:lan        # env + docker compose up --build

# --- compose.yaml (local web + signaling) ---
WEB_PORT=8080
WEB_HTTPS_PORT=8443

# Optional: add your PC’s LAN IP to the HTTPS self-signed cert (Subject Alternative Name).
# Reduces “wrong host” warnings when opening https://192.168.x.x:8443 on a phone. Rebuild web after changing.
# Example: TLS_EXTRA_SAN=IP:192.168.1.42
TLS_EXTRA_SAN=
SIGNALING_PORT=8787
SIGNALING_INTERNAL_PORT=8787

# Default WebSocket URL compiled into the static bundle. Users can override in the app (Settings → saved per browser).
# HTTPS dev stack: nginx serves TLS on WEB_HTTPS_PORT and proxies /signaling → signaling:8787 (use wss://…/signaling).
# Plain HTTP: use ws://127.0.0.1:8787 and open the app on WEB_PORT instead.
VITE_SIGNALING_URL=wss://127.0.0.1:8443/signaling

# Show violet LAN troubleshooting hints on failed connect in local/debug APK builds (not in release CI).
VITE_DEV_CONNECT_HINTS=true

# --- Phone or tablet on Wi‑Fi (same LAN as this PC) ---
# Replace 192.168.1.42 with `ip -brief a` / ipconfig address of the machine running Docker. Rebuild web after changing:
#   VITE_SIGNALING_URL=wss://192.168.1.42:8443/signaling
#   SIGNALING_ALLOWED_ORIGINS=…,https://192.168.1.42:8443,http://192.168.1.42:8080
# Open https://192.168.1.42:8443 on the phone (not https://127.0.0.1 — that is the phone itself).
# Quick workaround without rebuild: in the app Settings set the signaling URL to wss://192.168.1.42:8443/signaling

# Exact Origin allowlist for browser WebSocket handshakes (production signaling image uses NODE_ENV=production).
# Include every URL users type in the address bar, e.g. http://192.168.1.10:8080 or https://app.example.com
# Native clients typically send no Origin and remain allowed.
SIGNALING_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://127.0.0.1:8443,https://localhost:8443

# --- Behind Traefik: use compose.traefik.yaml with traefik.env.example instead ---
