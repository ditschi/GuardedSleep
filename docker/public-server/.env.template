# Environment for compose.yaml. Copy to `.env` next to it (git-ignored: it holds TURN_SECRET).
# Guide: README.md. Every setting that depends on a version or a provider names its doc link.

# --- Required ---

# Image owner on GHCR (lowercase GitHub login or organisation that publishes guardedsleep-signaling).
GUARDEDSLEEP_OWNER=ditschi

# A signaling-server-vX.Y.Z release (without the `signaling-server-` prefix), never latest or dev.
# No release exists until the owner cuts the first one after group 9 of alpha-connection-model;
# `vX.Y.Z` is a placeholder that fails to pull on purpose. Releases: the repository's Releases page.
SIGNALING_TAG=vX.Y.Z

# The public host name: signaling at wss://<PUBLIC_HOST>/signaling, STUN and TURN on the same host.
# The server refuses TURN_URLS and STUN_URLS that name another host.
PUBLIC_HOST=gs.mydata.rocks
TURN_URLS=turn:gs.mydata.rocks:3478?transport=udp,turn:gs.mydata.rocks:3478?transport=tcp
STUN_URLS=stun:gs.mydata.rocks:3478
# Active once the certificate exists (README, "Certificate for turns:"): the same list plus
#   turn:gs.mydata.rocks:3478?transport=udp,turn:gs.mydata.rocks:3478?transport=tcp,turns:gs.mydata.rocks:5349?transport=tcp
# Do not add the turns: URL earlier: clients would try it and wait for a timeout before falling back.

# Shared by the signaling server (signs credentials) and coturn (verifies them): 32 random bytes, hex
# only (the coturn image evaluates its arguments, so no shell characters). Generate with:
#   openssl rand -hex 32
# Rotation: set a new value, then `docker compose up -d` (both containers restart together).
TURN_SECRET=

# Contact address for Let's Encrypt expiry notices; the acme service (certificate for turns:) registers
# it. https://letsencrypt.org/docs/expiration-emails/
ACME_EMAIL=

# The HTTPS entrypoint name in your Traefik static config (CHECK: use the name from the owner's
# Oracle traefik files; `websecure` is only Traefik's documented convention).
# https://doc.traefik.io/traefik/routing/entrypoints/
TRAEFIK_ENTRYPOINT=websecure

# The host's own public addresses on the interface (`ip -br addr`; no 1:1 NAT on Contabo). coturn
# listens and relays on them and denies them as relay peers, so TURN can never reach services on this
# host. Contabo values below come from the owner's host (design section 9).
TURN_IPV4=167.86.115.143
TURN_IPV6=2a02:c207:3004:4659::1

# --- Optional (defaults shown) ---

# The plain HTTP entrypoint name in your Traefik static config: the acme service's HTTP-01 route
# (/.well-known/acme-challenge/ on PUBLIC_HOST) attaches there. https://doc.traefik.io/traefik/routing/entrypoints/
# TRAEFIK_HTTP_ENTRYPOINT=web
# ACME directory: `letsencrypt` (production) or `letsencrypt-staging` for a trial run without rate limits.
# https://go-acme.github.io/lego/usage/cli/obtain-a-certificate/
# ACME_SERVER=letsencrypt
# lego image tag override (default: the tag in compose.yaml, bumped by Renovate). https://hub.docker.com/r/goacme/lego/tags
# LEGO_TAG=

# Browser origins allowed to open a WebSocket (comma separated; production refuses an empty list).
# Default https://<PUBLIC_HOST>: that origin serves no web client, so no browser can use the server and
# native apps (no Origin header) still connect. Add the official web origin, if one exists.
# SIGNALING_ALLOWED_ORIGINS=https://gs.mydata.rocks
# Credential lifetime in seconds (1-600) and live credentials per client address
# (IPv4 address or IPv6 /64; many families share one carrier-grade NAT address).
# TURN_TTL_S=600
# TURN_MAX_LIVE_PER_ADDR=8

# Relay port range: open it in the firewall (udp) and keep TURN_TOTAL_QUOTA equal to its size
# (max - min + 1, one port per allocation).
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49359
# TURN_TOTAL_QUOTA=200
# Bytes per second per session (125000 = 1 Mbit/s).
# TURN_MAX_BPS=125000

# coturn image tag override (default: the tag in compose.yaml, bumped by Renovate; keep it equal to COTURN_IMAGE in
# tools/poc-images.env). https://hub.docker.com/r/coturn/coturn/tags
# COTURN_TAG=

# Monitoring (README, "Monitoring"): the Uptime Kuma push URL that check-turn.sh reports to.
# https://github.com/louislam/uptime-kuma/wiki/Push-monitor
# KUMA_PUSH_URL=

# Profile `web` only (OFF on gs.mydata.rocks, see compose.yaml): its own origin and a web image tag.
# WEB_HOST=
# WEB_TAG=
# A test deployment uses the guardedsleep-web-staging image; /signaling on the web host must not be routed
# (Traefik rule Host(web) && !PathPrefix(`/signaling`)).
