# Single pin for the Android native toolchain. Plain KEY=value lines, so shell can `source` it.
# Read by: scripts/core-build.sh, docker/android-native-build/Dockerfile, .devcontainer/Dockerfile,
# .github/actions/setup-android/action.yml. scripts/lib/build-image.sh hashes this file into the image
# label, so a bump rebuilds the build image. Details: docs/contributing/development.md.
#
# NDK: no Renovate datasource exists; bump by hand (sdkmanager --list shows the versions).
ANDROID_NDK_VERSION=30.0.16248370
# cargo-ndk: bumped by Renovate (custom regex manager in renovate.json, crates.io datasource).
CARGO_NDK_VERSION=4.1.2
