# Single pin for the container images of the emulator gate and the PoC scripts. Plain KEY=value lines, so shell can `source` it.
# Read by: scripts/poc/env-up.sh, scripts/poc/local-gate.sh, scripts/poc/turn-lifetime.sh, scripts/poc/public-server-logs.sh, scripts/poc/public-server-turns.sh.
# docker/turn/compose.yaml and docker/public-server/compose.yaml carry the same coturn tag in their COTURN_TAG defaults; keep them equal.
#
# coturn: bumped by Renovate (custom regex manager in renovate.json, docker datasource).
COTURN_IMAGE=coturn/coturn:4.18.0

# node: runs the PoC clients only (scripts/poc/*-client.mjs). Same digest as docker/web/Dockerfile (the docker group keeps both
# on one digest); bumped by Renovate (custom regex manager in renovate.json, docker datasource).
NODE_IMAGE=node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
