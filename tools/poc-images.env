# Single pin for the container images of the emulator gate. Plain KEY=value lines, so shell can `source` it.
# Read by: scripts/poc/env-up.sh, scripts/poc/local-gate.sh, scripts/poc/turn-lifetime.sh.
# docker/turn/compose.yaml (the VPS profile) carries the same tag in its COTURN_TAG default; keep them equal.
#
# coturn: bumped by Renovate (custom regex manager in renovate.json, docker datasource).
COTURN_IMAGE=coturn/coturn:4.18.0
