      "id": "baby",
      "role": "baby"
    },
    {
      "id": "parent",
      "role": "parent"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down",
      "relay": 1
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 40000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 10000
    },
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 10000
    },
    {
      "peer": "baby",
      "attempts": 1
    },
    {
      "peer": "parent",
      "attempts": 1
    },
    {
      "peer": "baby",
      "never": "link_lost"
    },
    {
      "peer": "parent",
      "never": "link_lost"
    },
    {
      "peer": "baby",
      "max_level": 0
    },
    {
      "peer": "parent",
