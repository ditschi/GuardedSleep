{
  "schema": "gs-scenario/1",
  "id": "nostr-all-mailboxes-dead-at-reachability-check",
  "description": "The own relay and every public relay are down when the 30-minute reachability check runs: nothing is reachable, both devices raise the calm hint and monitoring continues. When the relays return, the next check clears it.",
  "seed": 1,
  "max_seeds": 3,
  "peers": [
    {
      "id": "baby",
      "role": "baby",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        }
      ]
    },
    {
      "id": "parent",
      "role": "parent",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        }
      ]
    }
  ],
  "nostr": [
    {
      "url": "wss://nostr-a.example"
    },
    {
      "url": "wss://nostr-b.example"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down"
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 1700000,
      "do": "nostr_down",
      "id": "wss://nostr-a.example"
    },
    {
      "at": 1700000,
      "do": "nostr_down",
      "id": "wss://nostr-b.example"
    },
    {
      "at": 1900000,
      "do": "nostr_up",
      "id": "wss://nostr-a.example"
    },
    {
      "at": 1900000,
      "do": "nostr_up",
      "id": "wss://nostr-b.example"
    },
    {
      "at": 3700000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 3690000
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 3690000
    },
    {
      "peer": "parent",
      "event": "hint",
      "where": {
        "key": "recovery_path_unavailable",
        "active": true
      },
      "within_ms": [1800000, 1830000],
      "count": 1
    },
    {
      "peer": "baby",
      "event": "hint",
      "where": {
        "key": "recovery_path_unavailable",
        "active": true
      },
      "within_ms": [1800000, 1830000],
      "count": 1
    },
    {
      "peer": "parent",
      "event": "hint",
      "where": {
        "key": "recovery_path_unavailable",
        "active": false
      },
      "within_ms": [3600000, 3650000],
      "count": 1
    },
    {
      "peer": "parent",
      "never": "link_lost"
    }
  ]
}
