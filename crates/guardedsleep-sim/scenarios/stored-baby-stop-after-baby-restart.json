{
  "schema": "gs-scenario/1",
  "id": "stored-baby-stop-after-baby-restart",
  "description": "The baby stops on purpose while both devices hold a mailbox (the DataChannel is gone) and the parent honours it; the baby starts again with a new session and the pair verifies. When the link is lost later, a relay replays the old stop to the unchanged parent: it names a retired baby session, so it is ignored and escalation continues.",
  "seed": 1,
  "peers": [
    {
      "id": "baby",
      "role": "baby"
    },
    {
      "id": "parent",
      "role": "parent"
    }
  ],
  "relay": {},
  "timeline": [
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 10000,
      "do": "drop_data"
    },
    {
      "at": 50000,
      "do": "stop",
      "peer": "baby"
    },
    {
      "at": 51000,
      "do": "clear_faults"
    },
    {
      "at": 55000,
      "do": "start",
      "peer": "baby"
    },
    {
      "at": 100000,
      "do": "drop_data",
      "from": "baby"
    },
    {
      "at": 140000,
      "do": "replay_stop",
      "peer": "parent"
    },
    {
      "at": 250000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 90000
    },
    {
      "peer": "parent",
      "event": "peer_stopped",
      "count": 1
    },
    {
      "peer": "parent",
      "event": "link_lost",
      "count": 1,
      "since_last_contact_ms": [60000, 62000]
    },
    {
      "peer": "parent",
      "never": "status",
      "where": {
        "status": {
          "state": "peer_stopped"
        }
      },
      "within_ms": [90000, 250000]
    },
    {
      "peer": "parent",
      "reaches_level": 2
    }
  ]
}
