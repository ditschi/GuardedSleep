{
  "schema": "gs-scenario/1",
  "id": "two-relays-one-accepts-but-never-delivers",
  "description": "One relay stays up, answers pings and takes frames, but delivers no signal; the other works. Envelopes go to every relay, so the attempt verifies through the working one and the parent shows no error.",
  "seed": 1,
  "relay_count": 2,
  "peers": [
    {
      "id": "baby",
      "role": "baby"
    },
    {
      "id": "parent",
      "role": "parent"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "relay_drop_signals",
      "relay": 1
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 40000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 10000
    },
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 10000
    },
    {
      "peer": "baby",
      "attempts": 1
    },
    {
      "peer": "parent",
      "attempts": 1
    },
    {
      "peer": "baby",
      "max_level": 0
    },
    {
      "peer": "parent",
      "max_level": 0
    },
    {
      "peer": "baby",
      "never": "link_lost"
    },
    {
      "peer": "parent",
      "never": "link_lost"
    }
  ]
}
