{
  "schema": "gs-scenario/1",
  "id": "attack-mitm-after-pairing",
  "description": "After the pairing the relay turns hostile: it holds the PSK and sits between two DTLS sessions with a certificate of its own per leg, recomputing the pairing proof for each. It rewrites the signaling envelopes, so it cannot carry the tag that both pinned units require (the tag key derives from the parent secret and the tag covers the whole message): each rewritten envelope is refused before the message is read, no attempt is made through it, each unit warns once, and the parent never counts it as contact: it never reports connected, never reports a restored link, and its escalation reaches level 2 on schedule (alarm_after_ms after the last contact, 60 s, plus 2 s) however often the man in the middle cycles. Once the relay behaves again, the next presence announcement (at most five minutes later) brings the pair back.",
  "seed": 1,
  "relay": {},
  "peers": [
    {
      "id": "baby",
      "role": "baby"
    },
    {
      "id": "parent",
      "role": "parent"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 30000,
      "do": "relay_rewrite",
      "mode": "mitm_recompute"
    },
    {
      "at": 31000,
      "do": "drop_data"
    },
    {
      "at": 58000,
      "do": "clear_faults"
    },
    {
      "at": 210000,
      "do": "relay_rewrite"
    },
    {
      "at": 570000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 25000
    },
    {
      "peer": "baby",
      "event": "parent_pinned",
      "count": 1,
      "within_ms": [0, 30000]
    },
    {
      "peer": "baby",
      "event": "security_warning",
      "where": {
        "key": "unknown_parent_attempt"
      },
      "within_ms": [30000, 210000],
      "count_min": 1,
      "count_max": 1
    },
    {
      "peer": "parent",
      "event": "security_warning",
      "where": {
        "key": "wrong_key_attempt"
      },
      "within_ms": [30000, 210000],
      "count_min": 1,
      "count_max": 1
    },
    {
      "peer": "baby",
      "never": "status",
      "where": {
        "status": {
          "state": "connected"
        }
      },
      "within_ms": [70000, 210000]
    },
    {
      "peer": "baby",
      "never": "parent_connected",
      "within_ms": [60000, 210000]
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 560000
    },
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 560000
    },
    {
      "peer": "parent",
      "reaches_level": 2,
      "within_ms": [0, 93000]
    },
    {
      "peer": "parent",
      "never": "status",
      "where": {
        "status": {
          "state": "connected"
        }
      },
      "within_ms": [32000, 209000]
    },
    {
      "peer": "parent",
      "never": "link_restored",
      "within_ms": [32000, 209000]
    },
    {
      "peer": "parent",
      "event": "link_lost",
      "count": 1,
      "within_ms": [0, 209000]
    }
  ]
}
