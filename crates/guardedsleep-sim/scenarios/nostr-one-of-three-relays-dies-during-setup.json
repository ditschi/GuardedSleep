{
  "schema": "gs-scenario/1",
  "id": "nostr-one-of-three-relays-dies-during-setup",
  "description": "One of three public Nostr relays goes away while the pair is still setting up. Envelopes go to every open relay, so the offer and the answer still arrive through the other two and the attempt verifies within the 20 s limit.",
  "seed": 1,
  "peers": [
    {
      "id": "baby",
      "role": "baby",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-c.example"
        }
      ]
    },
    {
      "id": "parent",
      "role": "parent",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-c.example"
        }
      ]
    }
  ],
  "nostr": [
    {
      "url": "wss://nostr-a.example"
    },
    {
      "url": "wss://nostr-b.example"
    },
    {
      "url": "wss://nostr-c.example"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down"
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 1500,
      "do": "nostr_down",
      "id": "wss://nostr-b.example"
    },
    {
      "at": 40000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 19000
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 19000
    },
    {
      "peer": "parent",
      "max_level": 0
    },
    {
      "peer": "baby",
      "max_level": 0
    }
  ]
