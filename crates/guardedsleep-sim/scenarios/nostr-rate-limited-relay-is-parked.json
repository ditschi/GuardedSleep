{
  "schema": "gs-scenario/1",
  "id": "nostr-rate-limited-relay-is-parked",
  "description": "One public relay refuses events with a rate-limit answer after the first one in five seconds. The device leaves it out for a minute and the pair verifies through the other two relays.",
  "seed": 1,
  "peers": [
    {
      "id": "baby",
      "role": "baby",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-c.example"
        }
      ]
    },
    {
      "id": "parent",
      "role": "parent",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-c.example"
        }
      ]
    }
  ],
  "nostr": [
    {
      "url": "wss://nostr-a.example",
      "rate_limit": {
        "events": 1,
        "per_ms": 5000
      }
    },
    {
      "url": "wss://nostr-b.example"
    },
    {
      "url": "wss://nostr-c.example"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down"
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 40000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 19000
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 19000
    },
    {
      "peer": "parent",
      "max_level": 0
    },
    {
      "peer": "baby",
      "max_level": 0
    }
  ]
}
