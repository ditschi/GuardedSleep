{
  "schema": "gs-scenario/1",
  "id": "nostr-retention-and-failing-attempts-never-park-the-relay",
  "description": "One public relay keeps ephemeral events for five minutes and serves them to every re-subscription. For ten minutes no DataChannel message gets through, so attempt after attempt fails and the pair re-subscribes every minute. The relay serves the stored events again and again, but already seen events are dropped before they are counted: the relay is never left, and the pair verifies once the DataChannel works.",
  "seed": 1,
  "max_seeds": 5,
  "peers": [
    {
      "id": "baby",
      "role": "baby",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        }
      ]
    },
    {
      "id": "parent",
      "role": "parent",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        }
      ]
    }
  ],
  "nostr": [
    {
      "url": "wss://nostr-a.example",
      "retention_s": 300
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down"
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 2000,
      "do": "drop_data",
      "for_ms": 600000
    },
    {
      "at": 720000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 715000
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 715000
    },
    {
      "peer": "parent",
      "nostr_closes_max": 0,
      "within_ms": [10000, 600000]
    },
    {
      "peer": "baby",
      "nostr_closes_max": 0,
      "within_ms": [10000, 600000]
    }
  ]
}
