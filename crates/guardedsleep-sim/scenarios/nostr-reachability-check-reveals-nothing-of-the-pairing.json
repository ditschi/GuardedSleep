{
  "schema": "gs-scenario/1",
  "id": "nostr-reachability-check-reveals-nothing-of-the-pairing",
  "description": "A verified pair holds no mailbox. The own relay is down, so the 30-minute reachability check can only ask the public relays: a connect and a REQ with a random throwaway filter, answered with EOSE. Nothing of the pairing (no author, no daily tag) leaves, the hint stays down and monitoring continues.",
  "seed": 1,
  "max_seeds": 3,
  "peers": [
    {
      "id": "baby",
      "role": "baby",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        }
      ]
    },
    {
      "id": "parent",
      "role": "parent",
      "mailboxes": [
        {
          "kind": "nostr",
          "url": "wss://nostr-a.example"
        },
        {
          "kind": "nostr",
          "url": "wss://nostr-b.example"
        }
      ]
    }
  ],
  "nostr": [
    {
      "url": "wss://nostr-a.example"
    },
    {
      "url": "wss://nostr-b.example"
    }
  ],
  "timeline": [
    {
      "at": 0,
      "do": "signaling_down"
    },
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 2000000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 1990000
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 1990000
    },
    {
      "peer": "parent",
      "never": "hint",
      "where": {
        "key": "recovery_path_unavailable",
        "active": true
      }
    },
    {
      "peer": "baby",
      "never": "hint",
      "where": {
        "key": "recovery_path_unavailable",
        "active": true
      }
    },
    {
      "peer": "parent",
      "nostr_probe": true
    },
    {
      "peer": "baby",
      "nostr_probe": true
    },
    {
      "peer": "parent",
      "never": "status",
      "where": {
        "status": {
          "state": "reconnecting"
        }
      }
    }
  ]
}
