{
  "schema": "gs-scenario/1",
  "id": "turn-credentials-renewed-across-a-long-outage",
  "description": "The relay issues 60-second TURN credentials. The baby's Wi-Fi is gone for three minutes, three credential lifetimes, so the parent's set expires in the core and the room empties. When the baby returns, the relay issues fresh credentials before presence completes the room, and the new attempts carry only credentials that are still valid; none of the expired ones is ever handed out again.",
  "seed": 1,
  "peers": [
    {
      "id": "baby",
      "role": "baby"
    },
    {
      "id": "parent",
      "role": "parent"
    }
  ],
  "relay": {
    "ice": {
      "ttl_s": 60
    }
  },
  "timeline": [
    {
      "at": 0,
      "do": "start"
    },
    {
      "at": 20000,
      "do": "network_down",
      "peer": "baby"
    },
    {
      "at": 200000,
      "do": "network_up",
      "peer": "baby"
    },
    {
      "at": 300000,
      "do": "end"
    }
  ],
  "assert": [
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 15000
    },
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 15000
    },
    {
      "peer": "baby",
      "attempt_turn_valid": true,
      "within_ms": [0, 19000]
    },
    {
      "peer": "parent",
      "attempt_turn_valid": true,
      "within_ms": [0, 19000]
    },
    {
      "peer": "baby",
      "attempt_turn_valid": true,
      "within_ms": [200000, 300000]
    },
    {
      "peer": "parent",
      "attempt_turn_valid": true,
      "within_ms": [200000, 300000]
    },
    {
      "peer": "baby",
      "state": "connected",
      "at_ms": 300000
    },
    {
      "peer": "parent",
      "state": "connected",
      "at_ms": 300000
    }
  ]
}
