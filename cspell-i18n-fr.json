{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": ["./cspell-i18n-terms.json", "@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "fr,en",
  "files": ["locales/fr.json"],
  "ignoreRegExpList": [
    "/\"\\$meta\"\\s*:\\s*\\{[^}]*\\}/g",
    "/\\{[^}]+\\}/g",
    "/\"[A-Za-z0-9_.]+\"\\s*:/g"
  ]
}
