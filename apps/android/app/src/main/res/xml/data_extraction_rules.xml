<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device-to-device transfer: the pairing key
     and settings must be set up again on a new phone (AGENTS.md section 7, rule 2). Doc:
     https://developer.android.com/identity/data/autobackup#IncludingFiles -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
