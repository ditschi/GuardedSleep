{
  "name": "@guardedsleep/mobile",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "i18n:gen": "bash ../../scripts/cargo.sh run -q -p i18n-gen -- web --out apps/mobile/src/lib/i18n/generated",
    "predev": "pnpm run i18n:gen && pnpm run core:ensure",
    "dev": "vite dev --host 0.0.0.0",
    "prebuild": "pnpm run i18n:gen && pnpm run core:ensure",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "pnpm run i18n:gen && pnpm run core:ensure",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:i18n",
    "check:i18n": "vitest run src/lib/i18n/catalogue.test.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "pnpm run i18n:gen && pnpm run core:ensure",
    "test": "vitest run",
    "test:watch": "vitest",
    "core:ensure": "test -f ../../packages/core-wasm/pkg/guardedsleep_wasm_bg.wasm -a -f ../../packages/core-wasm/pkg-node/guardedsleep_wasm.js || pnpm --filter @guardedsleep/core-wasm build"
  },
  "dependencies": {
    "@guardedsleep/core-wasm": "workspace:*",
    "@zxing/browser": "^0.1.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
