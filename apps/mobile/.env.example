# Default WebSocket URL for the signaling server (baked in at build time).
# On baby/parent screens, users can override and persist a URL in localStorage.
VITE_SIGNALING_URL=ws://127.0.0.1:8787

# Show dev connection troubleshooting hints in failed-session UI (local Docker / debug APK).
VITE_DEV_CONNECT_HINTS=true

# Optional: force Android native OkHttp WSS bridge (debug self-signed LAN); usually same as DEV_CONNECT_HINTS.
# VITE_ANDROID_DEV_WSS=true
