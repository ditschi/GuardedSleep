{
  "name": "guardedsleep",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "GuardedSleep – Privacy Baby Monitor (monorepo root; app packages under apps/ later)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pre-commit run --all-files",
    "lint:cspell-i18n": "bash scripts/cspell-i18n.sh",
    "i18n:check": "bash scripts/cargo.sh run -q -p i18n-gen -- check",
    "i18n:gen": "bash scripts/cargo.sh run -q -p i18n-gen -- all",
    "i18n:test": "bash scripts/cargo.sh test -q -p i18n-gen",
    "prepare": "husky",
    "build": "pnpm -r build",
    "test": "pnpm --filter @guardedsleep/protocol build && pnpm -r test",
    "check": "pnpm -r check --if-present",
    "audit": "pnpm audit --audit-level=high",
    "dev:local": "pnpm --filter @guardedsleep/protocol build && concurrently -n signaling,mobile -c blue,green \"pnpm --filter @guardedsleep/signaling-server dev\" \"pnpm --filter @guardedsleep/mobile dev\"",
    "stack:lan:env": "bash scripts/stack-lan-env.sh",
    "stack:up": "docker compose -f docker/stack/compose.yaml --env-file docker/stack/.env up --build",
    "stack:lan": "bash scripts/stack-lan-env.sh && docker compose -f docker/stack/compose.yaml --env-file docker/stack/.env up --build",
    "diagnose:lan": "bash scripts/diagnose-lan-connect.sh",
    "check:kvm": "bash scripts/check-kvm.sh",
    "emulator:up": "bash scripts/android-emulator-docker.sh up",
    "emulator:wait": "bash scripts/android-emulator-docker.sh wait",
    "emulator:down": "bash scripts/android-emulator-docker.sh down",
    "emulator:status": "bash scripts/android-emulator-docker.sh status",
    "e2e:local:auto": "bash scripts/e2e-local-automation.sh",
    "e2e:docker": "bash scripts/e2e-docker-run.sh",
    "e2e:docker:auto": "bash scripts/e2e-docker-run.sh auto",
    "e2e:docker:browser": "bash scripts/e2e-docker-run.sh browser",
    "e2e": "pnpm --filter @guardedsleep/e2e test",
    "e2e:lan": "pnpm --filter @guardedsleep/e2e test:lan",
    "e2e:hybrid": "pnpm --filter @guardedsleep/e2e test:hybrid",
    "e2e:hybrid:lan": "pnpm --filter @guardedsleep/e2e test:hybrid:lan",
    "e2e:hybrid:lan-ws": "pnpm --filter @guardedsleep/e2e test:hybrid:lan-ws",
    "e2e:hybrid:lan-wss": "pnpm --filter @guardedsleep/e2e test:hybrid:lan-wss",
    "release:lint": "commitlint --from=${RELEASE_LINT_FROM:-origin/main} --to=HEAD --verbose",
    "release:preview": "npx --yes release-please release-pr --token=$GH_TOKEN --repo-url=$GITHUB_REPOSITORY --config-file=release-please-config.json --manifest-file=.release-please-manifest.json --dry-run --debug"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@cspell/dict-de-de": "^4.1.2",
    "@cspell/dict-es-es": "^3.0.8",
    "@cspell/dict-fr-fr": "^2.3.2",
    "concurrently": "^9.2.1",
    "cspell": "^10.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.5.1"
  }
}
