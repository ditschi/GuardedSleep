{
  "name": "guardedsleep",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "GuardedSleep – Privacy Baby Monitor (monorepo root; JavaScript tooling only, tasks run through `just`)",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:cspell-i18n": "bash scripts/cspell-i18n.sh",
    "i18n:check": "bash scripts/cargo.sh run -q -p i18n-gen -- check",
    "i18n:gen": "bash scripts/cargo.sh run -q -p i18n-gen -- all",
    "i18n:test": "bash scripts/cargo.sh test -q -p i18n-gen",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter '!@guardedsleep/e2e' test",
    "check": "pnpm -r --if-present run check",
    "audit": "pnpm audit --audit-level=high",
    "e2e": "pnpm --filter @guardedsleep/e2e test",
    "e2e:lan": "pnpm --filter @guardedsleep/e2e test:lan"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.3",
    "@cspell/dict-es-es": "^3.0.9",
    "@cspell/dict-fr-fr": "^2.3.2",
    "cspell": "^10.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2"
  }
}
