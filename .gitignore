apps/web/src/lib/i18n/generated/

# Generated by packages/core-wasm build (wasm-bindgen output)
packages/core-wasm/pkg/
packages/core-wasm/pkg-node/

# Agent worktrees (Claude Code)
.claude/worktrees/

# Kotlin compiler daemon sessions
.kotlin/
