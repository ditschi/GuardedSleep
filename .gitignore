apps/android/core-bindings/src/main/jniLibs/
apps/android/core-bindings/src/main/kotlin/uniffi/
apps/android/**/build/
apps/android/**/.gradle/
apps/android/local.properties

# Generated localization bundles (tools/i18n-gen)
